<?xml version="1.0" encoding="utf-8"?>
<!-- IPTV sources are often plain http/IP based; allow cleartext globally to match reference player behavior.
     Apple's aerial films still need explicit Apple Root CA trust on some Android versions. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">sylvan.apple.com</domain>
        <trust-anchors>
            <certificates src="@raw/apple_root_ca" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
